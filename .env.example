DATABASE_URL=postgresql://postgres:password@localhost:5432/hasebty
SECRET_KEY=change-this-to-a-long-random-secret
# Public address of the API, used to build full links to part pictures
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Only used by docker-compose (all optional, these are the defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=hasebty
